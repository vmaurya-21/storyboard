{
  "$schema": "https://typedoc.org/schema.json",
  "name": "SPX Connect Storyboard",
  "entryPoints": ["src/webparts/spxConnectStoryDragDrop"],
  "entryPointStrategy": "expand",
  "tsconfig": "./tsconfig.json",
  "out": "docs/api",
  "readme": "README.md",
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/loc/**",
    "**/*.module.scss"
  ],
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "categorizeByGroup": true,
  "hideGenerator": true,
  "githubPages": false,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  }
}
